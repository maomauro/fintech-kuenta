  <folder name="Business" id="id-da8904d513ea4e86878d4138b2915a02" type="business"/>
  <folder name="Application" id="id-f5cc58ff6179464692821f410156544d" type="application"/>
  <folder name="Technology &amp; Physical" id="id-aaeaa0265aba48a9a434d0b140efb5d8" type="technology"/>
  <folder name="Motivation" id="id-dade27675b6842f188a57cc0afae2258" type="motivation">
    <element xsi:type="archimate:Principle" name="PA-01 Seguridad y privacidad desde el diseño" id="id-a919098a93ab4421929c9a2bef72eb81">
      <documentation>Toda decisión protege primero la información y el dinero de las personas.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PA-02 El dinero siempre cuadra" id="id-4184e696c8164829817d3ef55351d1b5">
      <documentation>Ninguna operación se pierde, se duplica ni se deja a medias.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PA-03 Diseñar para fallar" id="id-b0d5e233562b4badafe977cfdee20120">
      <documentation>Se asume que todo componente puede fallar y el sistema se recupera dentro de sus objetivos.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PA-04 Cumplir es parte del diseño" id="id-aa2ce840a9c74c24aca2bfd587415ac8">
      <documentation>Cada obligación regulatoria es un requisito con dueño, historia y evidencia.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PA-05 Un solo dueño por cada dato" id="id-8abc0e2f6ddc4bf4bc1fa9496c511a38">
      <documentation>Cada dato pertenece a un dominio y los demás lo consultan, no lo copian ni lo modifican.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PA-06 Lo más simple que cumpla" id="id-047a46b810d94badb30c2648c6c33c9e">
      <documentation>Se empieza con la solución más simple que cumpla los requisitos y se complica solo con una razón medible.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PA-07 Evolución en pasos pequeños" id="id-e625a32456904562ae3d08131e9ba7d3">
      <documentation>Los cambios son pequeños, frecuentes y reversibles.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="PA-08 Automatizar la entrega y la evidencia" id="id-716021e155cd42acb95a742a2f467bb9">
      <documentation>Lo repetible se automatiza y la evidencia de auditoría se genera sola.</documentation>
    </element>
  </folder>
